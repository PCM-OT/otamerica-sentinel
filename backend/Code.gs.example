/**
 * SENTINEL — backend (Google Apps Script).
 *
 * ⚠️ Ajuste apenas o bloco CONFIG abaixo. O resto funciona como está.
 *
 * O QUE ESTE SCRIPT FAZ SOZINHO
 *   - cria as abas e as colunas que faltarem (nunca apaga nem reordena o que
 *     já existe: colunas novas entram no fim);
 *   - valida um token em toda requisição;
 *   - devolve JSON legível pelo navegador (permite WRITE_MODE 'cors' no app);
 *   - grava quem alterou o quê e quando (aba AUDITORIA);
 *   - envia por e-mail o resumo semanal de vencimentos.
 *
 * COMO INSTALAR (5 minutos)
 *   1. Planilha → Extensões → Apps Script. Cole este arquivo por cima do que
 *      estiver lá.
 *   2. Preencha CONFIG.SHEET_ID, CONFIG.TOKEN, CONFIG.DIGEST_TO e CONFIG.APP_URL.
 *   3. Na lista de funções, selecione `setup` e clique em Executar.
 *      Autorize quando o Google pedir. Isso cria abas/colunas e agenda o e-mail.
 *   4. Implantar → Nova implantação → App da Web
 *        Executar como: Eu
 *        Quem pode acessar: Qualquer pessoa
 *      Copie a URL /exec para assets/js/config.js → API_URL, e repita o token
 *      em API_TOKEN.
 */

const CONFIG = {
  /** ID da planilha: fica na URL, entre /d/ e /edit. */
  SHEET_ID: 'COLE_AQUI_O_ID_DA_PLANILHA',

  /**
   * Segredo compartilhado. Gere um valor aleatório e repita em
   * assets/js/config.js → API_TOKEN. Não é autenticação forte (o token também
   * fica no cliente), mas impede acesso de quem apenas descobriu a URL.
   */
  TOKEN: 'COLE_AQUI_UM_TOKEN_ALEATORIO',

  /**
   * ID de cliente OAuth do Google — o MESMO valor de
   * assets/js/config.js → AUTH.GOOGLE_CLIENT_ID.
   * Vazio = login Google desligado; o autor vira o nome digitado no app
   * (rastreabilidade, não autenticação).
   */
  GOOGLE_CLIENT_ID: '',

  /** URL pública do app (Vercel). Usada nos links do e-mail de alerta. */
  APP_URL: 'https://sentinel.vercel.app',

  SHEETS: { NR10: 'NR10', MANOMETRO: 'MANOMETRO', OUTROS: 'OUTROS' },
  LOG_SHEET: 'AUDITORIA',
  SUGGESTION_SHEET: 'SUGESTOES',
  /** Aba com duas colunas: EMAIL | PAPEL (leitor, editor ou admin). */
  USERS_SHEET: 'USUARIOS',
  /** Papel de quem não está na aba USUARIOS. */
  DEFAULT_ROLE: 'editor',

  /** Para quem vai o resumo. Separe vários com vírgula. */
  DIGEST_TO: 'manutencao@empresa.com.br',
  /** Alerta amarelo: quantos dias antes do vencimento entrar no resumo. */
  DIGEST_WARN_DAYS: 40,
};

/* ================================================================== *
 * ESQUEMA DA PLANILHA
 *
 * Cada par é [campo enviado pelo app, cabeçalho da coluna]. Para acrescentar
 * um campo novo: adicione o par aqui e em assets/js/config.js → FORM_CONFIG,
 * e rode `setup` de novo. A coluna é criada sozinha.
 * ================================================================== */

const FIELDS = {
  NR10: [
    ['tag', 'TAG'],
    ['equip', 'EQUIPAMENTO'],
    ['model', 'MODELO'],
    ['fab', 'FABRICANTE'],
    ['dimensoes', 'DIMENSÕES'],
    ['id_malao', 'ID MALÃO'],
    ['ordem_envio', 'ORDEM DE ENVIO'],
    ['local', 'LOCALIZAÇÃO'],
    ['lab', 'LABORATÓRIO / ORGANISMO CALIBRADOR'],
    ['result', 'RESULTADO'],
    ['incerteza', 'INCERTEZA DE MEDIÇÃO'],
    ['ema', 'ERRO MÁXIMO ADMISSÍVEL'],
    ['cert_date', 'DATA DE CERTIFICAÇÃO'],
    ['periodicidade', 'PERIODICIDADE (MESES)'],
    ['date', 'DATA DE VALIDADE'],
    ['cert_num', 'Nº DO CERTIFICADO'],
  ],
  MANOMETRO: [
    ['tag', 'TAG'],
    ['equip', 'EQUIPAMENTO'],
    ['n_serie', 'Nº SÉRIE'],
    ['model', 'MODELO'],
    ['fab', 'FABRICANTE'],
    ['fluido', 'FLUIDO'],
    ['faixa', 'FAIXA DE INDICAÇÃO'],
    ['glicerina', 'GLICERINA'],
    ['pos_conexao', 'POSIÇÃO DA CONEXÃO'],
    ['tipo_conexao', 'TIPO DE CONEXÃO'],
    ['diam_conexao', 'DIÂMETRO DA CONEXÃO'],
    ['mat_conexao', 'MATERIAL DA CONEXÃO'],
    ['diam_caixa', 'DIÂMETRO DA CAIXA'],
    ['mat_caixa', 'MATERIAL DA CAIXA'],
    ['equip_assoc', 'EQUIP. ASSOCIADO'],
    ['local', 'LOCALIZAÇÃO'],
    ['lab', 'LABORATÓRIO / ORGANISMO CALIBRADOR'],
    ['result', 'RESULTADO'],
    ['incerteza', 'INCERTEZA DE MEDIÇÃO'],
    ['ema', 'ERRO MÁXIMO ADMISSÍVEL'],
    ['cert_date', 'DATA DE CERTIFICAÇÃO'],
    ['periodicidade', 'PERIODICIDADE (MESES)'],
    ['date', 'DATA DE VALIDADE'],
    ['cert_num', 'Nº DO CERTIFICADO'],
  ],
  OUTROS: [
    ['tag', 'TAG'],
    ['equip', 'EQUIPAMENTO'],
    ['model', 'MODELO'],
    ['diam_conexao', 'DIÂMETRO DA CONEXÃO'],
    ['local', 'LOCALIZAÇÃO'],
    ['lab', 'LABORATÓRIO / ORGANISMO CALIBRADOR'],
    ['result', 'RESULTADO'],
    ['incerteza', 'INCERTEZA DE MEDIÇÃO'],
    ['ema', 'ERRO MÁXIMO ADMISSÍVEL'],
    ['cert_date', 'DATA DE CERTIFICAÇÃO'],
    ['periodicidade', 'PERIODICIDADE (MESES)'],
    ['date', 'DATA DE VALIDADE'],
    ['cert_num', 'Nº DO CERTIFICADO'],
  ],
};

/** Colunas de controle, presentes em todas as abas de equipamento. */
const SYSTEM_COLUMNS = ['LINK', 'SITUAÇÃO'];

const AUDIT_COLUMNS = ['DATA/HORA', 'AÇÃO', 'TAG', 'DETALHE', 'USUÁRIO'];
const USERS_COLUMNS = ['EMAIL', 'PAPEL'];
const SUGGESTION_COLUMNS = ['DATA', 'TIPO', 'MENSAGEM'];

function headersFor(cat) {
  return FIELDS[cat].map(function (pair) {
    return pair[1];
  }).concat(SYSTEM_COLUMNS);
}

/** { campo do app: cabeçalho da coluna } */
function fieldMapFor(cat) {
  const map = {};
  FIELDS[cat].forEach(function (pair) {
    map[pair[0]] = pair[1];
  });
  return map;
}

/* ------------------------------------------------------------------ *
 * Infraestrutura
 * ------------------------------------------------------------------ */

function json(payload) {
  return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(
    ContentService.MimeType.JSON,
  );
}

function checkToken(e) {
  if (!CONFIG.TOKEN) return; // token desligado
  const sent = (e && e.parameter && e.parameter.token) || '';
  if (sent !== CONFIG.TOKEN) throw new Error('Token inválido.');
}

function ss() {
  return SpreadsheetApp.openById(CONFIG.SHEET_ID);
}

/**
 * Garante que a aba exista e tenha todas as colunas esperadas.
 *
 * Nunca remove nem reordena o que já está lá: colunas ausentes são
 * acrescentadas no fim, então uma planilha antiga continua válida e os dados
 * existentes permanecem nas mesmas posições.
 *
 * Devolve { sheet, created, added }.
 */
function ensureSheet(name, headers) {
  const book = ss();
  let sheet = book.getSheetByName(name);
  let created = false;

  if (!sheet) {
    sheet = book.insertSheet(name);
    created = true;
  }

  // Aba vazia (recém-criada ou zerada): grava o cabeçalho inteiro.
  if (sheet.getLastRow() === 0) {
    if (sheet.getMaxColumns() < headers.length) {
      sheet.insertColumnsAfter(sheet.getMaxColumns(), headers.length - sheet.getMaxColumns());
    }
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    formatHeader(sheet, headers.length);
    return { sheet: sheet, created: created, added: headers };
  }

  const width = Math.max(sheet.getLastColumn(), 1);
  const existing = sheet.getRange(1, 1, 1, width).getValues()[0].map(function (h) {
    return String(h).trim();
  });

  const missing = headers.filter(function (h) {
    return existing.indexOf(h) === -1;
  });

  if (missing.length) {
    const firstNewColumn = existing.length + 1;
    const needed = firstNewColumn + missing.length - 1;
    if (sheet.getMaxColumns() < needed) {
      sheet.insertColumnsAfter(sheet.getMaxColumns(), needed - sheet.getMaxColumns());
    }
    sheet.getRange(1, firstNewColumn, 1, missing.length).setValues([missing]);
  }

  formatHeader(sheet, Math.max(existing.length, headers.length));
  return { sheet: sheet, created: created, added: missing };
}

function formatHeader(sheet, width) {
  const range = sheet.getRange(1, 1, 1, width);
  range.setFontWeight('bold');
  range.setBackground('#0b1121');
  range.setFontColor('#ffffff');
  sheet.setFrozenRows(1);
}

/**
 * Cria/completa todas as abas do sistema. Idempotente: rodar de novo não
 * duplica nada.
 */
function ensureSchema() {
  const report = [];

  Object.keys(CONFIG.SHEETS).forEach(function (cat) {
    const result = ensureSheet(CONFIG.SHEETS[cat], headersFor(cat));
    report.push(describe(CONFIG.SHEETS[cat], result));
  });

  report.push(describe(CONFIG.LOG_SHEET, ensureSheet(CONFIG.LOG_SHEET, AUDIT_COLUMNS)));
  report.push(describe(CONFIG.USERS_SHEET, ensureSheet(CONFIG.USERS_SHEET, USERS_COLUMNS)));
  report.push(describe(CONFIG.SUGGESTION_SHEET, ensureSheet(CONFIG.SUGGESTION_SHEET, SUGGESTION_COLUMNS)));

  return report;
}

function describe(name, result) {
  if (result.created) return name + ': aba criada com ' + result.added.length + ' colunas';
  if (result.added.length) return name + ': colunas acrescentadas → ' + result.added.join(', ');
  return name + ': já estava completa';
}

/** Aba de uma categoria, criada/completada se necessário. */
function sheetFor(cat) {
  if (!CONFIG.SHEETS[cat]) throw new Error('Categoria desconhecida: ' + cat);
  return ensureSheet(CONFIG.SHEETS[cat], headersFor(cat)).sheet;
}

/** Data de calendário → "dd/mm/aaaa" no fuso da planilha (evita o -1 dia). */
function formatDate(value) {
  if (!value) return '';
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return Utilities.formatDate(value, ss().getSpreadsheetTimeZone(), 'dd/MM/yyyy');
  }
  return String(value);
}

/* ================================================================== *
 * INSTALAÇÃO — execute `setup` uma vez, pelo editor do Apps Script.
 * ================================================================== */

function setup() {
  const schema = ensureSchema();
  const trigger = installDigestTrigger();

  const lines = ['SENTINEL — instalação concluída', ''].concat(schema, ['', trigger, '']);

  if (CONFIG.SHEET_ID.indexOf('COLE_AQUI') === 0) lines.push('⚠️ Preencha CONFIG.SHEET_ID.');
  if (CONFIG.TOKEN.indexOf('COLE_AQUI') === 0) lines.push('⚠️ Preencha CONFIG.TOKEN e repita em assets/js/config.js.');
  if (CONFIG.DIGEST_TO.indexOf('@empresa.com.br') !== -1) lines.push('⚠️ Ajuste CONFIG.DIGEST_TO.');

  lines.push('', 'Próximo passo: Implantar → Nova implantação → App da Web.');
  Logger.log(lines.join('\n'));
  return lines.join('\n');
}

/* ------------------------------------------------------------------ *
 * Identidade e permissões
 * ------------------------------------------------------------------ */

/**
 * Valida o ID token do Google e devolve o e-mail verificado, ou '' se o token
 * for inválido/ausente.
 *
 * É AQUI que a autenticação acontece de verdade. O front decodifica o mesmo
 * token para exibir o nome, mas isso não prova nada — qualquer um consegue
 * forjar um JWT sem assinatura válida.
 */
function verifyIdToken(idToken) {
  if (!idToken || !CONFIG.GOOGLE_CLIENT_ID) return '';
  try {
    const response = UrlFetchApp.fetch(
      'https://oauth2.googleapis.com/tokeninfo?id_token=' + encodeURIComponent(idToken),
      { muteHttpExceptions: true },
    );
    if (response.getResponseCode() !== 200) return '';
    const info = JSON.parse(response.getContentText());
    if (info.aud !== CONFIG.GOOGLE_CLIENT_ID) return '';
    if (info.email_verified !== 'true' && info.email_verified !== true) return '';
    return info.email || '';
  } catch (err) {
    return '';
  }
}

/** Papel do e-mail conforme a aba USUARIOS. */
function roleFor(email) {
  if (!email) return CONFIG.DEFAULT_ROLE;
  const sheet = ss().getSheetByName(CONFIG.USERS_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return CONFIG.DEFAULT_ROLE;

  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i += 1) {
    if (String(values[i][0]).trim().toLowerCase() === email.toLowerCase()) {
      return String(values[i][1]).trim().toLowerCase() || CONFIG.DEFAULT_ROLE;
    }
  }
  // A aba tem gente cadastrada e este e-mail não está lá: só leitura.
  return 'leitor';
}

const ROLE_PERMISSIONS = {
  leitor: [],
  editor: ['write'],
  admin: ['write', 'admin'],
};

/**
 * Resolve quem está fazendo a operação e verifica a permissão necessária.
 * Devolve { name, email, role } ou lança erro.
 */
function requirePermission(p, permission) {
  const email = verifyIdToken(p.idToken);

  // Com login Google ativo, exigir token verificado é o que torna a
  // autorização real. Sem ele, o nome enviado é apenas declarado.
  if (CONFIG.GOOGLE_CLIENT_ID && !email) {
    throw new Error('Faça login com sua conta Google para registrar alterações.');
  }

  const role = CONFIG.GOOGLE_CLIENT_ID ? roleFor(email) : CONFIG.DEFAULT_ROLE;
  if (permission && (ROLE_PERMISSIONS[role] || []).indexOf(permission) === -1) {
    throw new Error('Seu perfil (' + role + ') não permite esta operação.');
  }

  return {
    name: p.user || email || 'não identificado',
    email: email || p.userEmail || '',
    role: role,
  };
}

/* ------------------------------------------------------------------ *
 * Leitura
 * ------------------------------------------------------------------ */

function doGet(e) {
  try {
    checkToken(e);

    const action = (e && e.parameter && e.parameter.action) || '';
    if (action === 'whoami') return json(whoami(e.parameter));
    if (action === 'audit') return json(readAudit(Number(e.parameter.limit) || 300));

    const records = [];

    Object.keys(CONFIG.SHEETS).forEach(function (cat) {
      const sheet = ss().getSheetByName(CONFIG.SHEETS[cat]);
      if (!sheet || sheet.getLastRow() < 2) return;

      const values = sheet.getDataRange().getValues();
      const headers = values[0].map(function (h) {
        return String(h).trim();
      });
      const col = function (row, name) {
        const i = headers.indexOf(name);
        return i === -1 ? '' : row[i];
      };

      values.slice(1).forEach(function (row) {
        if (!String(col(row, 'TAG')).trim()) return;

        // Detalhes completos: tudo que existe na linha, para a ficha e o PDF.
        const fullDetails = {};
        headers.forEach(function (h, i) {
          if (h && row[i] !== '' && row[i] !== null) {
            fullDetails[h] = Object.prototype.toString.call(row[i]) === '[object Date]'
              ? formatDate(row[i])
              : String(row[i]);
          }
        });

        records.push({
          tag: String(col(row, 'TAG')).trim(),
          equip: String(col(row, 'EQUIPAMENTO') || ''),
          local: String(col(row, 'LOCALIZAÇÃO') || ''),
          cat: cat,
          model: String(col(row, 'MODELO') || ''),
          fab: String(col(row, 'FABRICANTE') || ''),
          certNum: String(col(row, 'Nº DO CERTIFICADO') || ''),
          result: String(col(row, 'RESULTADO') || ''),
          file: String(col(row, 'LINK') || ''),
          activeState: String(col(row, 'SITUAÇÃO') || 'Ativo'),
          // O front aceita "dd/mm/aaaa" e ISO; enviar formatado evita ambiguidade.
          dateStr: formatDate(col(row, 'DATA DE VALIDADE')),
          certDate: formatDate(col(row, 'DATA DE CERTIFICAÇÃO')),
          periodicidade: String(col(row, 'PERIODICIDADE (MESES)') || ''),
          lab: String(col(row, 'LABORATÓRIO / ORGANISMO CALIBRADOR') || ''),
          incerteza: String(col(row, 'INCERTEZA DE MEDIÇÃO') || ''),
          ema: String(col(row, 'ERRO MÁXIMO ADMISSÍVEL') || ''),
          fullDetails: fullDetails,
        });
      });
    });

    return json(records);
  } catch (err) {
    return json([{ error: true, msg: err.message }]);
  }
}

/** Papel do usuário logado — consumido por assets/js/session.js. */
function whoami(p) {
  const email = verifyIdToken(p.idToken);
  if (!email) return { ok: false, error: 'Token não verificado.' };
  return { ok: true, email: email, role: roleFor(email) };
}

/** Trilha de auditoria, do mais recente para o mais antigo. */
function readAudit(limit) {
  const sheet = ss().getSheetByName(CONFIG.LOG_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return [];

  const values = sheet.getDataRange().getValues();
  const rows = values.slice(1).reverse().slice(0, limit);

  return rows.map(function (r) {
    return {
      date: Object.prototype.toString.call(r[0]) === '[object Date]' ? r[0].toISOString() : String(r[0]),
      action: String(r[1] || ''),
      tag: String(r[2] || ''),
      detail: String(r[3] || ''),
      user: String(r[4] || ''),
    };
  });
}

/* ------------------------------------------------------------------ *
 * Escrita
 * ------------------------------------------------------------------ */

function doPost(e) {
  const lock = LockService.getScriptLock();
  try {
    checkToken(e);
    // Operações em massa chegam em paralelo: sem lock, duas escritas na mesma
    // aba se sobrepõem.
    lock.waitLock(30000);

    const p = e.parameter;
    switch (p.action) {
      case 'create':
        return json(createRecord(p, requirePermission(p, 'write')));
      case 'delete':
        return json(deactivate(p, requirePermission(p, 'write')));
      case 'update_date':
        return json(updateDate(p, requirePermission(p, 'write')));
      case 'import_csv':
        return json(importCsv(p, requirePermission(p, 'admin')));
      case 'suggestion':
        return json(saveSuggestion(p)); // aberta de propósito
      default:
        throw new Error('Ação desconhecida: ' + p.action);
    }
  } catch (err) {
    // ok:false permite ao front reportar o erro real quando WRITE_MODE = 'cors'.
    return json({ ok: false, error: err.message });
  } finally {
    try {
      lock.releaseLock();
    } catch (ignored) {
      /* lock já liberado */
    }
  }
}

/**
 * Trilha de auditoria: quem, quando, o quê.
 * O autor vem do e-mail verificado quando há login Google; senão, do nome
 * declarado no app (marcado como não verificado).
 */
function audit(action, tag, detail, author) {
  const sheet = ensureSheet(CONFIG.LOG_SHEET, AUDIT_COLUMNS).sheet;

  let who = 'anônimo';
  if (author && author.email) who = author.email;
  else if (author && author.name) who = author.name + ' (não verificado)';

  sheet.appendRow([new Date(), action, tag, detail, who]);
}

function findRows(sheet, tag) {
  const values = sheet.getDataRange().getValues();
  const headers = values[0].map(function (h) {
    return String(h).trim();
  });
  const tagCol = headers.indexOf('TAG');
  const rows = [];

  for (let i = 1; i < values.length; i += 1) {
    if (String(values[i][tagCol]).trim() === String(tag).trim()) rows.push(i + 1);
  }
  return { rows: rows, headers: headers };
}

function createRecord(p, author) {
  const sheet = sheetFor(p.cat); // cria aba/colunas se faltarem
  const map = fieldMapFor(p.cat);
  const headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(function (h) {
    return String(h).trim();
  });

  // Cabeçalho → valor, usando o mapa de campos; o que não for do formulário
  // fica em branco (SITUAÇÃO entra como Ativo).
  const byHeader = {};
  Object.keys(map).forEach(function (field) {
    if (p[field] !== undefined) byHeader[map[field]] = p[field];
  });

  const row = headers.map(function (h) {
    if (h === 'SITUAÇÃO') return 'Ativo';
    return byHeader[h] !== undefined ? byHeader[h] : '';
  });

  sheet.appendRow(row);

  if (p.fileData && p.fileName) {
    const blob = Utilities.newBlob(Utilities.base64Decode(p.fileData), p.mimeType, p.fileName);
    const file = DriveApp.createFile(blob);
    const linkCol = headers.indexOf('LINK');
    if (linkCol !== -1) sheet.getRange(sheet.getLastRow(), linkCol + 1).setValue(file.getUrl());
  }

  audit('create', p.tag, p.cat, author);
  return { ok: true, tag: p.tag };
}

function deactivate(p, author) {
  const sheet = sheetFor(p.cat);
  const found = findRows(sheet, p.tag);
  const col = found.headers.indexOf('SITUAÇÃO');
  if (col === -1) throw new Error('Coluna SITUAÇÃO não encontrada.');
  if (!found.rows.length) throw new Error('TAG não encontrada: ' + p.tag);

  found.rows.forEach(function (r) {
    sheet.getRange(r, col + 1).setValue('Inativo');
  });

  audit('delete', p.tag, p.reason || '', author);
  return { ok: true, rows: found.rows.length };
}

function updateDate(p, author) {
  const sheet = sheetFor(p.cat);
  const found = findRows(sheet, p.tag);
  const col = found.headers.indexOf('DATA DE VALIDADE');
  if (col === -1) throw new Error('Coluna DATA DE VALIDADE não encontrada.');
  if (!found.rows.length) throw new Error('TAG não encontrada: ' + p.tag);

  // Atualiza apenas a linha mais recente da TAG.
  const row = found.rows[found.rows.length - 1];
  sheet.getRange(row, col + 1).setValue(p.newDate);

  audit('update_date', p.tag, p.newDate, author);
  return { ok: true, newDate: p.newDate };
}

function saveSuggestion(p) {
  const sheet = ensureSheet(CONFIG.SUGGESTION_SHEET, SUGGESTION_COLUMNS).sheet;
  sheet.appendRow([new Date(), p.type, p.msg]);
  return { ok: true };
}

function importCsv(p, author) {
  const sheet = sheetFor(p.cat);
  const rows = Utilities.parseCsv(p.csvContent);
  if (!rows.length) throw new Error('CSV vazio.');

  // Backup automático antes de destruir os dados atuais — a operação não tem
  // desfazer pela interface.
  const backupName = CONFIG.SHEETS[p.cat] + '_BACKUP_' + Utilities.formatDate(
    new Date(), ss().getSpreadsheetTimeZone(), 'yyyyMMdd_HHmmss',
  );
  sheet.copyTo(ss()).setName(backupName);

  sheet.clearContents();
  sheet.getRange(1, 1, rows.length, rows[0].length).setValues(rows);

  // O CSV pode vir sem as colunas novas; recompõe o cabeçalho.
  ensureSheet(CONFIG.SHEETS[p.cat], headersFor(p.cat));

  audit('import_csv', p.cat, rows.length - 1 + ' linhas (backup: ' + backupName + ')', author);
  return { ok: true, rows: rows.length - 1, backup: backupName };
}

/* ================================================================== *
 * ALERTAS POR E-MAIL
 *
 * É o que faz o sistema deixar de ser passivo: em vez de esperar alguém
 * abrir o painel, ele avisa.
 *
 *   installDigestTrigger()  agenda o envio (roda uma vez)
 *   testDigest()            mostra o texto no log, sem enviar
 *   sendExpiryDigest()      envia agora (o acionador chama esta)
 * ================================================================== */

/** Cria (ou recria) o acionador semanal do resumo de vencimentos. */
function installDigestTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (trigger) {
    if (trigger.getHandlerFunction() === 'sendExpiryDigest') ScriptApp.deleteTrigger(trigger);
  });

  ScriptApp.newTrigger('sendExpiryDigest')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.MONDAY)
    .atHour(7)
    .create();

  return 'Resumo semanal agendado: segunda-feira, 7h → ' + CONFIG.DIGEST_TO;
}

/** Monta o resumo e apenas registra no log — confira antes de agendar. */
function testDigest() {
  const digest = buildDigest();
  Logger.log(digest.text || 'Nenhum vencimento a reportar no momento.');
  return digest.text;
}

function sendExpiryDigest() {
  const digest = buildDigest();
  if (!digest.text) return; // nada a reportar: não enche a caixa de entrada

  MailApp.sendEmail({
    to: CONFIG.DIGEST_TO,
    subject: '[Sentinel] ' + digest.expired.length + ' vencidos, ' + digest.soon.length + ' a vencer',
    body: digest.text,
    htmlBody: digest.html,
  });
}

/** Devolve { text, html, expired, soon }. */
function buildDigest() {
  const data = JSON.parse(doGet({ parameter: { token: CONFIG.TOKEN } }).getContent());
  if (data.length && data[0].error) throw new Error(data[0].msg);

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  // Mantém apenas o registro de maior validade por TAG.
  const latest = {};
  data.forEach(function (r) {
    if (r.activeState === 'Inativo' || !r.dateStr) return;
    const parts = String(r.dateStr).split('/');
    if (parts.length !== 3) return;
    const date = new Date(Number(parts[2]), Number(parts[1]) - 1, Number(parts[0]));
    if (!latest[r.tag] || date > latest[r.tag].date) latest[r.tag] = { rec: r, date: date };
  });

  const expired = [];
  const soon = [];

  Object.keys(latest).forEach(function (tag) {
    const rec = latest[tag].rec;
    const days = Math.round((latest[tag].date - today) / 86400000);
    const item = {
      tag: tag,
      equip: rec.equip || '',
      local: rec.local || '',
      date: rec.dateStr,
      days: days,
      // Certificado reprovado bloqueia o equipamento mesmo dentro do prazo.
      rejected: String(rec.result).toUpperCase() === 'REPROVADO',
    };
    if (days < 0 || item.rejected) expired.push(item);
    else if (days <= CONFIG.DIGEST_WARN_DAYS) soon.push(item);
  });

  const bySeverity = function (a, b) {
    return a.days - b.days;
  };
  expired.sort(bySeverity);
  soon.sort(bySeverity);

  if (!expired.length && !soon.length) return { text: '', html: '', expired: expired, soon: soon };

  const line = function (i) {
    const status = i.rejected ? 'REPROVADO' : i.days < 0 ? 'vencido há ' + Math.abs(i.days) + ' dias' : 'faltam ' + i.days + ' dias';
    return i.tag + ' — ' + i.equip + (i.local ? ' (' + i.local + ')' : '') + ' — vence ' + i.date + ' — ' + status;
  };

  const dateLabel = Utilities.formatDate(today, ss().getSpreadsheetTimeZone(), 'dd/MM/yyyy');
  const text = [
    'Resumo Sentinel — ' + dateLabel,
    '',
    'VENCIDOS / BLOQUEADOS (' + expired.length + ')',
    expired.length ? expired.map(line).join('\n') : 'nenhum',
    '',
    'VENCEM EM ATÉ ' + CONFIG.DIGEST_WARN_DAYS + ' DIAS (' + soon.length + ')',
    soon.length ? soon.map(line).join('\n') : 'nenhum',
    '',
    'Abrir o painel: ' + CONFIG.APP_URL,
  ].join('\n');

  const row = function (i, color) {
    return (
      '<tr>' +
      '<td style="padding:6px 10px;border-bottom:1px solid #e2e8f0;font-family:monospace">' +
      '<a href="' + CONFIG.APP_URL + '?tag=' + encodeURIComponent(i.tag) + '">' + i.tag + '</a></td>' +
      '<td style="padding:6px 10px;border-bottom:1px solid #e2e8f0">' + i.equip + '</td>' +
      '<td style="padding:6px 10px;border-bottom:1px solid #e2e8f0">' + i.local + '</td>' +
      '<td style="padding:6px 10px;border-bottom:1px solid #e2e8f0">' + i.date + '</td>' +
      '<td style="padding:6px 10px;border-bottom:1px solid #e2e8f0;color:' + color + ';font-weight:bold">' +
      (i.rejected ? 'REPROVADO' : i.days < 0 ? Math.abs(i.days) + ' dias vencido' : i.days + ' dias') +
      '</td></tr>'
    );
  };

  const table = function (title, items, color, link) {
    if (!items.length) return '';
    return (
      '<h3 style="font-family:sans-serif;color:' + color + '">' + title + ' (' + items.length + ')</h3>' +
      '<table style="border-collapse:collapse;font-family:sans-serif;font-size:13px;width:100%">' +
      '<tr style="background:#0b1121;color:#fff"><th align="left" style="padding:6px 10px">TAG</th>' +
      '<th align="left" style="padding:6px 10px">Equipamento</th>' +
      '<th align="left" style="padding:6px 10px">Local</th>' +
      '<th align="left" style="padding:6px 10px">Vencimento</th>' +
      '<th align="left" style="padding:6px 10px">Situação</th></tr>' +
      items.map(function (i) { return row(i, color); }).join('') +
      '</table>' +
      '<p style="font-family:sans-serif;font-size:12px"><a href="' + link + '">Ver no painel</a></p>'
    );
  };

  const html =
    '<div style="max-width:760px">' +
    '<h2 style="font-family:sans-serif;color:#0b1121">Sentinel — resumo de ' + dateLabel + '</h2>' +
    table('Vencidos / bloqueados', expired, '#ef4444', CONFIG.APP_URL + '?view=dash&status=danger') +
    table('Vencem em até ' + CONFIG.DIGEST_WARN_DAYS + ' dias', soon, '#b45309', CONFIG.APP_URL + '?view=dash&status=warn') +
    '</div>';

  return { text: text, html: html, expired: expired, soon: soon };
}
